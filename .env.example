# These are ONLY needed if you want Elyra to receive and auto-reply to
# incoming WhatsApp messages on her own (the /api/whatsapp/webhook route).
# They are irrelevant to normal browser use - the browser flow uses the
# Gemini key and WhatsApp credentials you enter in Settings instead.
#
# You will not see any effect from these until you:
#   1. Deploy this app somewhere with a public HTTPS URL
#   2. Create a Meta developer app with the WhatsApp product enabled
#   3. Point its webhook at https://<your-domain>/api/whatsapp/webhook
#      and set the verify token below to match what you enter in Meta's console

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ELYRA_WHATSAPP_AUTOREPLY=false
